# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Private Owner Login Email (kept strictly separate from Customer Care email).
ADMIN_EMAIL="owner@ojasnatural.in"

# ADMIN_PASSWORD: Owner Login Password (set a strong private password via environment secrets).
ADMIN_PASSWORD="SET_STRONG_OWNER_PASSWORD"

# ADMIN_RECOVERY_KEY: Secret key required to initialize or reset the Owner Portal password.
ADMIN_RECOVERY_KEY="SET_SECRET_RECOVERY_KEY"

# SESSION_SECRET: Secret key used to sign session tokens.
SESSION_SECRET="change-this-to-a-long-random-secret"

# Customer Password Reset Email Configuration (Gmail SMTP / Custom SMTP / Resend)
# Option 1: Gmail SMTP with App Password (recommended for Gmail)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option 2: Custom SMTP Server
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OJAS <customercareojas@gmail.com>"

# Option 3: Resend Email API
RESEND_API_KEY=""
EMAIL_FROM="OJAS <onboarding@resend.dev>"

